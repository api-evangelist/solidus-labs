{
  "opencollection": "1.0.0",
  "info": {
    "name": "Address Address API API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Address API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tokensniffer.com/api/v2/addresses/:address",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "address",
                "value": "",
                "type": "path",
                "description": "Contract address or EOA"
              }
            ]
          },
          "docs": "Get scam tokens for address.  Available with the Pro and Enterprise plans."
        }
      ]
    }
  ],
  "bundled": true
}