{
  "opencollection": "1.0.0",
  "info": {
    "name": "Webhooks Webhooks API API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tokensniffer.com/api/v3/webhooks/",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "event_type",
                "value": "",
                "type": "query",
                "description": "Filter results by event type."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip."
              }
            ]
          },
          "docs": "Return a paginated list of all active webhook subscriptions."
        },
        {
          "info": {
            "name": "Create Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://tokensniffer.com/api/v3/webhooks/",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new webhook subscription."
        },
        {
          "info": {
            "name": "Get Webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://tokensniffer.com/api/v3/webhooks/:subscription_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the subscription to fetch."
              }
            ]
          },
          "docs": "Fetch the configuration details for a webhook subscription."
        },
        {
          "info": {
            "name": "Update Webhook",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://tokensniffer.com/api/v3/webhooks/:subscription_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the subscription to update."
              }
            ]
          },
          "docs": "Update Webhook"
        },
        {
          "info": {
            "name": "Delete Webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://tokensniffer.com/api/v3/webhooks/:subscription_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "subscription_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the subscription to fetch."
              }
            ]
          },
          "docs": "Deactivate a webhook subscription."
        }
      ]
    }
  ],
  "bundled": true
}